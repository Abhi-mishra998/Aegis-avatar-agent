# =============================================================================
# SECRETS — NEVER COMMIT
# Block every variant. Only *.example files are safe to push.
# =============================================================================
.env
.env.*
*.env
*.env.*
.envrc
.direnv/

# Explicitly allow example/template files only
!.env.example
!.env.*.example
!*.env.example
!.env.example.*

# Provider key files / credentials
*secret*
*Secret*
*SECRET*
*credential*
*Credential*
*CREDENTIAL*
*.pem
*.key
*.pfx
*.p12
*.cer
*.crt
service-account*.json
gcp-key*.json
aws-credentials*
.aws/
.gcp/
.netrc

# Tokens / session artifacts dropped by various SDKs
.tavus/
.heygen/
.daily/
.livekit/
*.token
*.session

